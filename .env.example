# bagoye-board 백엔드 환경변수 템플릿
# 이 파일을 .env 등으로 복사해 값을 채우세요. 실제 값이 든 파일은 커밋하지 마세요(.gitignore 처리됨).
# Spring Boot는 .env를 자동으로 읽지 않으므로, 셸에서 export 하거나 IDE 실행 설정에 등록해야 합니다.

# 선택: 기본값 jdbc:mysql://localhost:3306/db_bagoye?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_URL=
# 필수
DB_USERNAME=
# 필수
DB_PASSWORD=
# 필수: 32바이트 이상 (생성 예: openssl rand -base64 48)
JWT_SECRET_KEY=
# 필수: 업로드 저장 디렉토리, 끝에 / 포함
FILE_PATH=
# 선택: 기본값 http://localhost:8080/file/
FILE_URL=
# 선택: 쉼표 구분, * 불가. 기본값 http://localhost:3000
CORS_ALLOWED_ORIGINS=
